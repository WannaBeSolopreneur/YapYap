{
  // Deploy: cd web && ./build.sh && npx wrangler@4 deploy
  "name": "yapyap-site",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "yapyap.cc", "custom_domain": true },
    { "pattern": "www.yapyap.cc", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
